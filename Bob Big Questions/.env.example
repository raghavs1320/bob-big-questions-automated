# ==============================================================================
# BOB BIG QUESTIONS - TEMPLATE CONFIGURATION (.env.example)
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AI Model for Script Writing
DEFAULT_MODEL=gemini-3.5-flash-lite

# Voice Engine (Edge Neural TTS - Free & Unlimited, No API Key Required)
NARRATOR_VOICE=en-US-AvaNeural
NARRATOR_RATE=+2%

# Multi-Language Voice Defaults
NARRATOR_VOICE_HINDI=hi-IN-SwaraNeural
NARRATOR_VOICE_SPANISH=es-MX-DaliaNeural

# Audio & Video Production Parameters
AUDIO_LUFS=-14
MUSIC_DUCKING_VOLUME=0.30
RESOLUTION_WIDTH=1920
RESOLUTION_HEIGHT=1080
FPS=30
VIDEO_ENCODER=h264_videotoolbox
