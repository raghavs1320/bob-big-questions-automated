# ==============================================================================
# DAILY DOSE STUDIO - CONFIGURATION SETTINGS
# ==============================================================================
# Copy this file to '.env' and fill in your keys when you are ready.

# 1. Google Gemini API Key (100% Free from https://aistudio.google.com/)
# Used for watching the video clips and writing the funny jokes.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Preferred Video Narration Voice
# Default: Calm, clear, deadpan narrator voice (100% free)
NARRATOR_VOICE=en-US-ChristopherNeural

# 3. Default Video Resolution
# Options: "1080p" (1920x1080 horizontal) or "shorts" (1080x1920 vertical)
DEFAULT_ASPECT_RATIO=16:9

# 4. Optional Mobile Notifications (Telegram Bot)
# Leave blank if you don't need phone approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

